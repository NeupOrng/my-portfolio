# Contact form → Telegram bot
# 1. Create a bot with @BotFather and copy its token.
# 2. Send your bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=

# Live site origin. Defaults to https://orngneup.dev (nuxt.config.ts); set this
# only to override it, e.g. for a preview domain.
# NUXT_PUBLIC_SITE_URL=
